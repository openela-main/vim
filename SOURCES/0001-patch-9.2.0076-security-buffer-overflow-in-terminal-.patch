diff -up vim82/src/terminal.c.terminal-buffer-over vim82/src/terminal.c
--- vim82/src/terminal.c.terminal-buffer-over	2026-09-03 13:17:56.096841408 +0200
+++ vim82/src/terminal.c	2026-09-03 13:17:56.102272151 +0200
@@ -3281,12 +3281,13 @@ handle_pushline(int cols, const VTermScr
 	{
 	    for (col = 0; col < len; col += cells[col].width)
 	    {
-		if (ga_grow(&ga, MB_MAXBYTES) == FAIL)
+		if (ga_grow(&ga, VTERM_MAX_CHARS_PER_CELL * 4) == FAIL)
 		{
 		    ga.ga_len = 0;
 		    break;
 		}
-		for (i = 0; (c = cells[col].chars[i]) > 0 || i == 0; ++i)
+		for (i = 0; i < VTERM_MAX_CHARS_PER_CELL &&
+		    ((c = cells[col].chars[i]) > 0 || i == 0); ++i)
 		    ga.ga_len += utf_char2bytes(c == NUL ? ' ' : c,
 					     (char_u *)ga.ga_data + ga.ga_len);
 		cell2cellattr(&cells[col], &p[col]);
